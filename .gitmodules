[submodule "sel4/kernel"]
	path = sel4/kernel
	url = https://github.com/seL4/seL4.git
[submodule "sel4/tools"]
	path = sel4/tools
	url = https://github.com/seL4/seL4_tools.git
[submodule "sel4/projects/seL4_libs"]
	path = sel4/projects/seL4_libs
	url = https://github.com/seL4/seL4_libs.git
[submodule "sel4/projects/musllibc"]
	path = sel4/projects/musllibc
	url = https://github.com/seL4/musllibc.git
[submodule "sel4/projects/util_libs"]
	path = sel4/projects/util_libs
	url = https://github.com/seL4/util_libs.git
[submodule "sel4/projects/sel4runtime"]
	path = sel4/projects/sel4runtime
	url = https://github.com/seL4/sel4runtime.git
[submodule "bootloader/grub"]
	path = bootloader/grub
	url = https://git.savannah.gnu.org/git/grub.git
	ignore = dirty
